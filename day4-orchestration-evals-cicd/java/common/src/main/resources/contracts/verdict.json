{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "checks",
    "reasons"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "block"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "One item per claim you re-checked. verified and source belong inside each item.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "verified"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 300
          },
          "verified": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "safer_alternative": {
      "type": "string",
      "maxLength": 400
    }
  }
}