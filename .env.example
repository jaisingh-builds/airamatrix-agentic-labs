# AiraMatrix — Agentic AI & Agentic Coding
# Copy this file to .env and paste YOUR key from the access card you were given.
# .env is gitignored. Never commit it, never paste your key into chat or a ticket.

# Both values are on your access card. Copy them exactly.
ANTHROPIC_BASE_URL=https://GATEWAY-HOST
ANTHROPIC_AUTH_TOKEN=sk-PASTE-YOUR-KEY-HERE

# Model used by the lab code. claude-sonnet is the default for every lab.
# claude-opus is available and much more expensive; claude-haiku is cheapest.
LAB_MODEL=claude-sonnet

# Guardrails for your own code. Both are deliberately low.
LAB_MAX_STEPS=8
LAB_BUDGET_USD=0.50
