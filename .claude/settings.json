{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(python3 *test*)",
      "Bash(node --test*)",
      "Bash(mvn -q test*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Read(**)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(aws iam *)",
      "Bash(curl * /key/generate*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secrets.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-graded-tests.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous-bash.sh"
          }
        ]
      }
    ]
  }
}
